      <root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;MoMo SMS Analytics - System Architecture&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontColor=#222222;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="700" height="36" as="geometry"/></mxCell><mxCell id="etl" value='&lt;b style="font-size:13px"&gt;ETL  (etl/run.py)&lt;/b&gt;' style="rounded=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;strokeColor=#999999;whiteSpace=wrap;html=1;fillColor=#F2F2F2;fontColor=#222222;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="240" y="80" width="900" height="140" as="geometry"/></mxCell><mxCell id="xml" value='&lt;b style="font-size:13px"&gt;momo.xml&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;SMS export (data/raw/)&lt;/span&gt;' style="shape=document;boundedLbl=1;size=0.15;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#222222;fontColor=#222222;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="160" height="85" as="geometry"/></mxCell><mxCell id="parse" value='&lt;b style="font-size:13px"&gt;parse_xml.py&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;read SMS records&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#222222;fontColor=#222222;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="260" y="120" width="150" height="70" as="geometry"/></mxCell><mxCell id="clean" value='&lt;b style="font-size:13px"&gt;clean_normalize.py&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;amounts, dates, phones&lt;/span&gt;' style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#222222;fontColor=#222222;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="430" y="120" width="150" height="70" as="geometry"/></mxCell><mxCell id="cat" value='&lt;b style="font-size:13px"&gt;categorize.py&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:11px"&gt;transaction types