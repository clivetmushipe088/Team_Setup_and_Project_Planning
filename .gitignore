# --- Data (raw input and generated outputs stay local) ---
data/raw/*
!data/raw/.gitkeep
data/processed/*.json
data/db.sqlite3
data/*.sqlite3-journal
data/logs/*.log
data/logs/dead_letter/*
!data/logs/dead_letter/.gitkeep

# --- Environment ---
.env
.venv/
venv/

# --- Python ---
__pycache__/
*.py[cod]
.pytest_cache/

# --- OS / editors ---
.DS_Store
.vscode/
.idea/
