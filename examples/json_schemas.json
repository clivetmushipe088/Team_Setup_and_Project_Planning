{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MoMo SMS Analytics - JSON Schemas and API Examples",
  "description": "JSON Schema (draft-07) definitions for every entity in momo_sms_db, together with worked examples. Every example in this file was generated by querying the live MySQL database, so the examples are genuine serialisations of real rows rather than hand-written approximations.",
  "version": "1.0.0",
  "database": "momo_sms_db (MySQL 8.0+, InnoDB, utf8mb4)",
  "author": "Clive Tanaka Mushipe",
  "serialization_rules": {
    "money": "DECIMAL(15,2) -> decimal STRING, never a JSON number. IEEE-754 doubles cannot represent every two-decimal value exactly, and a rounding error in a balance is a bug that compounds silently.",
    "timestamps": "DATETIME -> ISO-8601 with an explicit +02:00 (Africa/Kigali) offset. MySQL DATETIME stores no timezone, so the API attaches one on the way out.",
    "enums": "MySQL ENUM -> JSON string, constrained by a JSON Schema `enum` with identical members.",
    "nulls": "SQL NULL -> JSON null. Nullable columns are typed as [\"<type>\", \"null\"] rather than omitted, so a client can tell 'absent from the SMS' from 'field not requested'.",
    "booleans": "MySQL BOOLEAN (TINYINT(1)) -> true / false.",
    "foreign_keys": "An FK is never serialised as a bare id. It is replaced by the nested object it points at, so one API call returns everything the client needs.",
    "junction_tables": "transaction_participants and transaction_tags are never exposed as top-level resources. They appear as the nested `participants` and `tags` arrays, and attributes stored ON the relationship (role, confidence, tagged_by) travel inside those items.",
    "pii": "Public responses carry masked phone numbers (+250788****045) from v_transaction_summary. national_id and raw_sms_body are omitted entirely unless the caller is privileged.",
    "parties_without_a_phone": "A merchant till or service endpoint has no MSISDN, so there is nothing to mask. Those participants serialise their party_ref instead - a till code identifies a shop, not a person, so it is not PII. has_msisdn tells the client which of the two it received, rather than leaving it to pattern-match the string."
  },
  "definitions": {
    "money_amount": {
      "type": "string",
      "pattern": "^-?\\d+\\.\\d{2}$",
      "description": "Monetary value as a decimal STRING, not a JSON number. IEEE-754 doubles cannot represent every 2-decimal value exactly, so serialising DECIMAL(15,2) as a float can silently corrupt a balance. The string preserves the exact value stored in MySQL.",
      "examples": [
        "150000.00",
        "0.00",
        "1200.50"
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 with explicit UTC offset. MySQL DATETIME carries no timezone, so the API attaches Africa/Kigali (+02:00) on serialisation.",
      "examples": [
        "2026-01-12T13:30:00+02:00"
      ]
    },
    "msisdn": {
      "type": "string",
      "pattern": "^\\+250[0-9]{9}$",
      "description": "Rwandan mobile number in E.164 format.",
      "examples": [
        "+250788110045"
      ]
    },
    "msisdn_masked": {
      "type": "string",
      "pattern": "^\\+250[0-9]{3}\\*{4}[0-9]{3}$",
      "description": "Masked MSISDN as returned by v_transaction_summary. Public API responses use this form; the unmasked number is never serialised to an unprivileged client.",
      "examples": [
        "+250788****045"
      ]
    },
    "user": {
      "type": "object",
      "description": "Maps to table `users`. One row per distinct party. Keyed on party_ref rather than phone_number, because merchant tills and service endpoints have no MSISDN.",
      "required": [
        "user_id",
        "party_ref",
        "user_type",
        "account_status"
      ],
      "additionalProperties": false,
      "properties": {
        "user_id": {
          "type": "integer",
          "minimum": 1,
          "description": "users.user_id (PK)"
        },
        "party_ref": {
          "type": "string",
          "minLength": 3,
          "maxLength": 64,
          "description": "users.party_ref (UNIQUE natural key). Either a normalised E.164 MSISDN or a service code such as 'MTN:MoMoPay:Kigali_Mart'. Always present, which is why it - and not phone_number - is the key.",
          "examples": [
            "+250789876543",
            "MTN:MoMoPay:Kigali_Mart"
          ]
        },
        "full_name": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 2,
          "maxLength": 120,
          "description": "Null when the source never names the party."
        },
        "is_verified": {
          "type": "boolean",
          "description": "users.is_verified - KYC state."
        },
        "phone_number": {
          "oneOf": [
            {
              "$ref": "#/definitions/msisdn"
            },
            {
              "type": "null"
            }
          ],
          "description": "users.phone_number. NULL for merchant tills and service endpoints. Validated only when present, so the guarantee holds without making half the source data unstorable."
        },
        "user_type": {
          "type": "string",
          "enum": [
            "customer",
            "merchant",
            "agent",
            "bank",
            "system"
          ]
        },
        "national_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 32,
          "description": "KYC reference; null when unknown. Omitted entirely from public responses."
        },
        "account_status": {
          "type": "string",
          "enum": [
            "active",
            "suspended",
            "closed"
          ]
        },
        "first_seen_at": {
          "$ref": "#/definitions/timestamp"
        },
        "created_at": {
          "$ref": "#/definitions/timestamp"
        },
        "updated_at": {
          "$ref": "#/definitions/timestamp"
        }
      }
    },
    "transaction_category": {
      "type": "object",
      "description": "Maps to table `transaction_categories`.",
      "required": [
        "category_id",
        "code",
        "name",
        "direction"
      ],
      "additionalProperties": false,
      "properties": {
        "category_id": {
          "type": "integer",
          "minimum": 1
        },
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{2,39}$",
          "description": "transaction_categories.category_code"
        },
        "name": {
          "type": "string",
          "maxLength": 80
        },
        "direction": {
          "type": "string",
          "enum": [
            "credit",
            "debit",
            "neutral"
          ],
          "description": "Effect on the wallet balance."
        },
        "description": {
          "type": "string",
          "maxLength": 255
        },
        "is_active": {
          "type": "boolean"
        }
      }
    },
    "tag": {
      "type": "object",
      "description": "Maps to table `tags`.",
      "required": [
        "tag_id",
        "name",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "tag_id": {
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{1,49}$"
        },
        "type": {
          "type": "string",
          "enum": [
            "analytics",
            "data_quality",
            "user_defined"
          ]
        },
        "description": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 255
        },
        "confidence": {
          "type": "string",
          "pattern": "^[01]\\.\\d{2}$",
          "description": "transaction_tags.confidence - an attribute of the RELATIONSHIP, not of the tag. It appears inside the nested tag object because that is where a client needs it."
        },
        "tagged_by": {
          "type": "string",
          "enum": [
            "etl",
            "analyst",
            "rule_engine"
          ],
          "description": "transaction_tags.tagged_by"
        },
        "tagged_at": {
          "$ref": "#/definitions/timestamp"
        }
      }
    },
    "participant": {
      "type": "object",
      "description": "One row of the `transaction_participants` junction, joined to `users`. The junction itself is never exposed as a top-level API resource - it is an implementation detail of the M:N relationship.",
      "required": [
        "role",
        "user_id",
        "party_ref"
      ],
      "additionalProperties": false,
      "properties": {
        "role": {
          "type": "string",
          "enum": [
            "sender",
            "receiver"
          ],
          "description": "transaction_participants.role"
        },
        "user_id": {
          "type": "integer"
        },
        "full_name": {
          "type": "string"
        },
        "party_ref": {
          "type": "string",
          "description": "users.party_ref - the canonical identifier."
        },
        "masked_ref": {
          "oneOf": [
            {
              "$ref": "#/definitions/msisdn_masked"
            },
            {
              "type": "string"
            }
          ],
          "description": "What an unprivileged client may display: the masked MSISDN when the party has one, otherwise the party_ref, which is not PII. Named masked_ref rather than phone_number because for a merchant till it holds a code, not a number - and a field whose name lies about its contents is worse than a slightly longer name. Matches the sender_ref_masked / receiver_ref_masked columns of v_transaction_summary."
        },
        "has_msisdn": {
          "type": "boolean",
          "description": "Whether this party is a phone subscriber. Saves a client pattern-matching phone_number to work out whether it is a number or a till code."
        },
        "user_type": {
          "type": "string",
          "enum": [
            "customer",
            "merchant",
            "agent",
            "bank",
            "system"
          ]
        },
        "party_label": {
          "type": [
            "string",
            "null"
          ],
          "description": "Name exactly as printed in this SMS, preserved even if users.full_name is later corrected."
        }
      }
    },
    "system_log": {
      "type": "object",
      "description": "Maps to table `system_logs`.",
      "required": [
        "log_id",
        "stage",
        "event_type",
        "level",
        "message",
        "created_at"
      ],
      "additionalProperties": false,
      "properties": {
        "log_id": {
          "type": "integer"
        },
        "transaction_id": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Null when the SMS never became a transaction - for example a parse failure. This is exactly the record an engineer needs to debug the ETL."
        },
        "stage": {
          "type": "string",
          "enum": [
            "parse",
            "clean",
            "categorize",
            "load",
            "export",
            "audit"
          ]
        },
        "event_type": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{2,79}$",
          "description": "system_logs.event_type - machine-readable event name. Indexed, so it is what a client should filter on rather than the free-text message.",
          "examples": [
            "PARSE_SUCCESS",
            "DB_DUPLICATE",
            "AMOUNT_CHANGED"
          ]
        },
        "level": {
          "type": "string",
          "enum": [
            "DEBUG",
            "INFO",
            "WARNING",
            "ERROR",
            "CRITICAL"
          ]
        },
        "message": {
          "type": "string",
          "maxLength": 500
        },
        "source_file": {
          "type": [
            "string",
            "null"
          ]
        },
        "record_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "records_affected": {
          "type": "integer",
          "minimum": 0
        },
        "ip_address": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 45,
          "description": "Host that performed the action."
        },
        "created_at": {
          "$ref": "#/definitions/timestamp"
        }
      }
    },
    "transaction": {
      "type": "object",
      "description": "A complete transaction as returned by GET /transactions/{id}. Flattens the `transactions` row and nests every related entity so a client needs exactly one request.",
      "required": [
        "transaction_id",
        "reference",
        "category",
        "amounts",
        "transaction_date",
        "status",
        "participants"
      ],
      "additionalProperties": false,
      "properties": {
        "transaction_id": {
          "type": "integer",
          "description": "transactions.transaction_id (PK). BIGINT in MySQL; safe as a JSON number until 2^53."
        },
        "reference": {
          "type": "string",
          "maxLength": 40,
          "description": "transactions.external_txn_ref (UNIQUE)"
        },
        "category": {
          "$ref": "#/definitions/transaction_category",
          "description": "Denormalised from the FK join, so the client never needs a second request."
        },
        "amounts": {
          "type": "object",
          "description": "The four money columns grouped into one object. They always travel together and are meaningless apart from their currency.",
          "required": [
            "principal",
            "fee",
            "currency"
          ],
          "additionalProperties": false,
          "properties": {
            "principal": {
              "$ref": "#/definitions/money_amount",
              "description": "transactions.amount"
            },
            "fee": {
              "$ref": "#/definitions/money_amount",
              "description": "transactions.fee"
            },
            "balance_after": {
              "oneOf": [
                {
                  "$ref": "#/definitions/money_amount"
                },
                {
                  "type": "null"
                }
              ],
              "description": "transactions.balance_after. Null when the source SMS did not report it."
            },
            "total": {
              "$ref": "#/definitions/money_amount",
              "description": "COMPUTED, not stored: amount + fee, the full value moved including charges. Derived on serialisation so clients do not re-implement the arithmetic."
            },
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            }
          }
        },
        "transaction_date": {
          "$ref": "#/definitions/timestamp"
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "completed",
            "failed",
            "reversed"
          ]
        },
        "channel": {
          "type": "string",
          "enum": [
            "sms",
            "ussd",
            "app",
            "api"
          ]
        },
        "notes": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500,
          "description": "transactions.notes - an analyst annotation. Never written by the ETL, so a non-null value means a human looked at this record."
        },
        "participants": {
          "type": "array",
          "description": "Resolves the users M:N transactions relationship. 0-2 entries: a failed message may have only a sender, airtime has a system receiver.",
          "minItems": 0,
          "maxItems": 2,
          "items": {
            "$ref": "#/definitions/participant"
          }
        },
        "tags": {
          "type": "array",
          "description": "Resolves the transactions M:N tags relationship.",
          "items": {
            "$ref": "#/definitions/tag"
          }
        },
        "source": {
          "type": "object",
          "description": "Provenance. Present only for privileged clients: raw_sms_body can contain PII and sms_hash is an internal deduplication key.",
          "additionalProperties": false,
          "properties": {
            "raw_sms_body": {
              "type": "string",
              "description": "transactions.raw_sms_body"
            },
            "sms_hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$",
              "description": "transactions.sms_hash (UNIQUE)"
            },
            "channel": {
              "type": "string"
            },
            "processed_at": {
              "$ref": "#/definitions/timestamp"
            }
          }
        },
        "processing_log": {
          "type": "array",
          "description": "Related system_logs rows (1:M).",
          "items": {
            "$ref": "#/definitions/system_log"
          }
        }
      }
    },
    "pagination": {
      "type": "object",
      "required": [
        "page",
        "page_size",
        "total_items",
        "total_pages"
      ],
      "additionalProperties": false,
      "properties": {
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "page_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "total_items": {
          "type": "integer",
          "minimum": 0
        },
        "total_pages": {
          "type": "integer",
          "minimum": 0
        },
        "has_next": {
          "type": "boolean"
        }
      }
    },
    "error_response": {
      "type": "object",
      "required": [
        "error"
      ],
      "additionalProperties": false,
      "properties": {
        "error": {
          "type": "object",
          "required": [
            "code",
            "message"
          ],
          "additionalProperties": false,
          "properties": {
            "code": {
              "type": "string",
              "description": "Stable machine-readable code."
            },
            "message": {
              "type": "string"
            },
            "details": {
              "type": [
                "object",
                "null"
              ]
            },
            "db_constraint": {
              "type": [
                "string",
                "null"
              ],
              "description": "The database constraint that rejected the write, surfaced so the client can tell a duplicate from a bad value."
            }
          }
        }
      }
    }
  },
