<mxfile host="app.diagrams.net">
  <diagram id="momo-architecture" name="System Architecture">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1980" pageHeight="1100" math="0" shadow="0">
      <root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;MoMo SMS Analytics - System Architecture&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontColor=#1A1F2B;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="44" y="24" width="900" height="34" as="geometry"/></mxCell><mxCell id="sub" value="Python + SQL &#183; MySQL 8.0+ / InnoDB &#183; Clive Tanaka Mushipe" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#5A6479;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="44" y="58" width="900" height="22" as="geometry"/></mxCell><mxCell id="etlgroup" value="&lt;b&gt;ETL  ·  etl/run.py&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F5F7FA;strokeColor=#C9D0DB;fontColor=#5A6479;fontFamily=Helvetica;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="300" y="96" width="880" height="190" as="geometry"/></mxCell><mxCell id="xml" value="&lt;b&gt;modified_sms_v2.xml&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10px&quot;&gt;data/raw/  ·  25 SMS records&lt;/span&gt;" style="shape=document;boundedLbl=1;size=0.15;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E3A4F;fontColor=#1A1F2B;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="143" width="210" height="96" as="geometry"/></mxCell><mxCell id="parse" value="&lt;b&gt;parse_xml.py&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10px&quot;&gt;read SMS records&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E3A4F;fontColor=#1A1F2B;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="322" y="152" width="196" height="74" as="geometry"/></mxCell><mxCell id="clean" value="&lt;b&gt;clean_normalize.py&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10px&quot;&gt;amounts, dates, 07→+250&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E3A4F;fontColor=#1A1F2B;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="534" y="152" width="196" height="74" as="geometry"/></mxCell><mxCell id="categ" value="&lt;b&gt;categorize.py&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10px&quot;&gt;10 category codes&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E3A4F;fontColor=#1A1F2B;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="746" y="152" width="196" height="74" as="geometry"/></mxCell><mxCell id="load" value="&lt;b&gt;load_db.py&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10px&quot;&gt;insert, dedupe&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E3A4F;fontColor=#1A1F2B;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="958" y="152" width="202" height="74" as="geometry"/></mxCell><mxCell id="mysql" value="&lt;b&gt;MySQL  ·  momo_sms_db&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10px&quot;&gt;7 tables · 3 views · 5 triggers&lt;/span&gt;" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=12;whiteSpace=wrap;html=1;fillColor=#40546E;strokeColor=#2E3A4F;fontColor=#FFFFFF;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1310" y="138" width="250" height="118" as="geometry"/></mxCell><mxCell id="logs" value="&lt;b&gt;system_logs  +  data/logs/&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10px&quot;&gt;stage, event_type, level, ip_address&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E3A4F;fontColor=#1A1F2B;fontFamily=Helvetica;dashed=1;" vertex="1" parent="1"><mxGeometry x="322" y="336" width="420" height="76" as="geometry"/></mxCell><mxCell id="views" value="&lt;b&gt;Reporting views&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10px&quot;&gt;v_daily_summary · v_category_totals&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10px&quot;&gt;v_transaction_summary (PII masked)&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E3A4F;fontColor=#1A1F2B;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1300" y="318" width="270" height="96" as="geometry"/></mxCell><mxCell id="mkdash" value="&lt;b&gt;make_dashboard.py&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10px&quot;&gt;queries the database&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF8F2;strokeColor=#7A4A2E;fontColor=#1A1F2B;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1270" y="470" width="330" height="78" as="geometry"/></mxCell><mxCell id="dashhtml" value="&lt;b&gt;dashboard.html&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10px&quot;&gt;data/processed/ · self-contained&lt;/span&gt;" style="shape=document;boundedLbl=1;size=0.15;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E3A4F;fontColor=#1A1F2B;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1270" y="606" width="330" height="92" as="geometry"/></mxCell><mxCell id="browser" value="&lt;b&gt;Browser&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10px&quot;&gt;opens the file directly&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E3A4F;fontColor=#1A1F2B;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1320" y="762" width="230" height="70" as="geometry"/></mxCell><mxCell id="api" value="&lt;b&gt;FastAPI  ·  api/&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10px&quot;&gt;/transactions  /analytics&lt;/span&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10px&quot;&gt;reads via momo_app (no DELETE)&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9AA0B0;fontColor=#1A1F2B;fontFamily=Helvetica;dashed=1;" vertex="1" parent="1"><mxGeometry x="1660" y="318" width="280" height="96" as="geometry"/></mxCell><mxCell id="buildgrp" value="&lt;b&gt;Build-time  ·  scripts/build/   ·   documentation is generated, not hand-written&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F5F7FA;strokeColor=#C9D0DB;fontColor=#5A6479;fontFamily=Helvetica;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="40" y="900" width="1540" height="162" as="geometry"/></mxCell><mxCell id="mkerd" value="&lt;b&gt;make_erd.py&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10px&quot;&gt;→ docs/erd_diagram.drawio/.svg/.png&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF8F2;strokeColor=#7A4A2E;fontColor=#1A1F2B;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="70" y="962" width="300" height="74" as="geometry"/></mxCell><mxCell id="mkshots" value="&lt;b&gt;make_screenshots.py&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10px&quot;&gt;runs every .sql, captures real output&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF8F2;strokeColor=#7A4A2E;fontColor=#1A1F2B;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="390" y="962" width="300" height="74" as="geometry"/></mxCell><mxCell id="mkjson" value="&lt;b&gt;make_json.py&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10px&quot;&gt;→ examples/json_schemas.json&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF8F2;strokeColor=#7A4A2E;fontColor=#1A1F2B;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="710" y="962" width="300" height="74" as="geometry"/></mxCell><mxCell id="mkdoc" value="&lt;b&gt;make_doc.py&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10px&quot;&gt;→ database_design_document.pdf&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF8F2;strokeColor=#7A4A2E;fontColor=#1A1F2B;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1030" y="962" width="300" height="74" as="geometry"/></mxCell><mxCell id="mkarch" value="&lt;b&gt;make_architecture.py&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:10px&quot;&gt;→ this diagram&lt;/span&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF8F2;strokeColor=#7A4A2E;fontColor=#1A1F2B;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1350" y="962" width="210" height="74" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#44506A;fontSize=10;fontColor=#5A6479;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="xml" target="parse"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#44506A;fontSize=10;fontColor=#5A6479;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="parse" target="clean"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#44506A;fontSize=10;fontColor=#5A6479;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="clean" target="categ"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#44506A;fontSize=10;fontColor=#5A6479;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="categ" target="load"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="INSERT" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#44506A;fontSize=10;fontColor=#5A6479;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="load" target="mysql"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="errors" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#44506A;fontSize=10;fontColor=#5A6479;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="parse" target="logs"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#44506A;fontSize=10;fontColor=#5A6479;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="mysql" target="views"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="SELECT" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#44506A;fontSize=10;fontColor=#5A6479;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="views" target="mkdash"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="writes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#44506A;fontSize=10;fontColor=#5A6479;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="mkdash" target="dashhtml"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#44506A;fontSize=10;fontColor=#5A6479;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="dashhtml" target="browser"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="SELECT" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;strokeColor=#44506A;fontSize=10;fontColor=#5A6479;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="views" target="api"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="legend" value="LEGEND&#10;&#10;Solid box      runtime component&#10;Dark cylinder  datastore&#10;Orange box     generator script&#10;Dashed         optional / error path&#10;&#10;There is no hand-written frontend. The&#10;dashboard is generated from the database&#10;by a Python script, so the source of this&#10;project stays Python and SQL only." style="text;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=#FAFBFC;strokeColor=#C9D0DB;fontSize=11;fontColor=#3C4659;fontFamily=Helvetica;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1660" y="470" width="280" height="300" as="geometry"/></mxCell></root>
