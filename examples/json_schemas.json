  "sql_to_json_mapping": {
    "users": {
      "json_location": "definitions.user / transaction.participants[]",
      "columns": {
        "user_id": "user_id (integer)",
        "party_ref": "party_ref (string) - the natural key. Not PII: a till code identifies a shop, not a person.",
        "phone_number": "phone_number - MASKED to +250788****045 in public responses; null becomes the party_ref instead",
        "(derived)": "has_msisdn (boolean) - whether phone_number was non-null",
        "full_name": "full_name (string or null)",
        "is_verified": "is_verified (boolean)",
        "user_type": "user_type (string enum)",
        "national_id": "national_id - OMITTED from public responses (PII)",
        "account_status": "account_status (string enum)",
        "first_seen_at": "first_seen_at (ISO-8601)"
      }
    },
    "transaction_categories": {
      "json_location": "transaction.category (nested, not an id)",
      "columns": {
        "category_id": "category.category_id",
        "category_code": "category.code",
        "category_name": "category.name",
        "direction": "category.direction",
        "description": "category.description",
        "is_active": "category.is_active (boolean)"
      }
    },
    "transactions": {
      "json_location": "definitions.transaction (root object)",
      "columns": {
        "transaction_id": "transaction_id (integer)",
        "external_txn_ref": "reference (string)",
        "category_id": "REPLACED by the nested category object",
        "amount": "amounts.principal (decimal string)",
        "fee": "amounts.fee (decimal string)",
        "balance_after": "amounts.balance_after (decimal string or null)",
        "currency": "amounts.currency",
        "(computed)": "amounts.total = amount + fee",
        "transaction_date": "transaction_date (ISO-8601 +02:00)",
        "status": "status (string enum)",
        "channel": "channel (string enum)",
        "notes": "notes (string or null) - analyst annotation",
        "raw_sms_body": "source.raw_sms_body - privileged clients only",
        "sms_hash": "source.sms_hash - privileged clients only",
        "processed_at": "source.processed_at"
      }
    },
    "transaction_participants": {
      "json_location": "transaction.participants[] - the M:N junction, flattened",
      "note": "Never a top-level resource. Each array item merges the junction row with the users row it points at.",
      "columns": {
        "participation_id": "NOT serialised - internal surrogate key",
        "transaction_id": "implicit - it is the parent object",
        "user_id": "participants[].user_id",
        "(joined)": "participants[].party_ref, .full_name, .masked_ref",
        "role": "participants[].role - the relationship attribute",
        "party_label": "participants[].party_label"
      }
    },
    "tags": {
      "json_location": "transaction.tags[]",
      "columns": {
        "tag_id": "tags[].tag_id",
        "tag_name": "tags[].name",
        "tag_type": "tags[].type",
        "description": "tags[].description"
      }
    },
    "transaction_tags": {
      "json_location": "transaction.tags[] - merged into the tag object",
      "note": "The composite PK disappears in JSON: transaction_id is the parent and tag_id is on the item. Only the relationship's own attributes survive.",
      "columns": {
        "transaction_id": "implicit - the parent object",
        "tag_id": "tags[].tag_id",
        "confidence": "tags[].confidence (decimal string)",
        "tagged_by": "tags[].tagged_by",
        "tagged_at": "tags[].tagged_at (ISO-8601)"
      }
    },
    "system_logs": {
      "json_location": "transaction.processing_log[] or a standalone /logs resource",
      "columns": {
        "log_id": "log_id",
        "transaction_id": "transaction_id (integer or null)",
        "stage": "stage",
        "event_type": "event_type - the field to filter on; it is indexed and the free-text message is not",
        "log_level": "level - RENAMED, 'log_level' is redundant inside a log object",
        "message": "message",
        "source_file": "source_file",
        "record_ref": "record_ref",
        "records_affected": "records_affected",
        "ip_address": "ip_address (string or null)",
        "created_at": "created_at (ISO-8601)"
      }
    },
    "v_transaction_summary": {
      "json_location": "the public/unprivileged shape of transaction",
      "note": "Reading the view rather than the base tables is what guarantees masked phone numbers reach the client."
    }
  }
