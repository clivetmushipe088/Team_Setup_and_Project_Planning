            "party_ref": "+250789876543",
            "full_name": "Account Owner",
            "masked_ref": "+250789****543",
            "has_msisdn": true,
            "user_type": "customer",
            "party_label": "+250789876543"
          },
          {
            "role": "receiver",
            "user_id": 3,
            "party_ref": "MTN:MoMoPay:Kigali_Mart",
            "full_name": "Kigali Mart",
            "masked_ref": "MTN:MoMoPay:Kigali_Mart",
            "has_msisdn": false,
