# --- Data (raw input and generated outputs stay local) ---
data/raw/*
!data/raw/.gitkeep
# The 25-record course sample is small and needs to be in the repo so the
# schema and ETL can be run and marked without a separate download.
# The full MTN export stays local and is still ignored by the rule above.
!data/raw/modified_sms_v2.xml
data/processed/*.json
data/db.sqlite3
data/*.sqlite3-journal
data/logs/*.log
data/logs/dead_letter/*
!data/logs/dead_letter/.gitkeep

# --- Environment ---
.env
.venv/
venv/

# --- Python ---
__pycache__/
*.py[cod]
.pytest_cache/

# --- OS / editors ---
.DS_Store
.vscode/
.idea/
